# ---- Credentials: never commit these ----
kaggle.json
.kaggle/
*.key
.env
.env.*
wandb/

# ---- Large data: regenerated by notebooks/01, not version controlled ----
dataset/raw/*
dataset/preprocessed/*
!dataset/raw/.gitkeep
!dataset/preprocessed/.gitkeep
*.csv
*.tsv
*.jsonl
*.parquet
*.zip
*.tar.gz

# ---- Model artefacts ----
checkpoints/
*.bin
*.safetensors
*.pt
*.pth
*.onnx
runs/

# ---- Experiment outputs ----
# Generated figures/tables are ignored by default so binary blobs do not creep
# into history. For the coursework submission you probably DO want the final
# figures committed, since the grader will not run your GPU jobs:
# comment out the three lines below, then `git add results/`.
# See results/README.md for the trade-off.
results/*.png
results/*.csv
results/*.json
!results/README.md
!results/.gitkeep

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
